# --- X (Twitter) API Anahtarları (Developer Portal -> Keys and tokens) ---
# Uygulama izinlerinin "Read and write" olduğundan emin olun!
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret

# --- Google Gemini API Anahtarı (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-4-hydrogen

# --- Bot Ayarları ---
# true: X'e gerçek paylaşım yapmaz, çıktıyı ekrana yazar ve medyayı output_preview/ klasörüne kaydeder.
DRY_RUN=true

# Her çalışmada en fazla kaç haber paylaşılsın? (X Free Tier için 1 önerilir)
MAX_POSTS_PER_RUN=1

# Tweet sonuna haber linki eklensin mi? (false önerilir: X Pay-Per-Use'da linkli tweet $0.20, linksiz $0.015)
INCLUDE_SOURCE_LINK=false

# Görseli olmayan haberler için üretilen kartta görünecek marka adı
BRAND_NAME=HABER EXE

# --- Anlık Takip Modu (watch.py) Ayarları ---
WATCH_INTERVAL_SECONDS=120
WATCH_MAX_AGE_MINUTES=30
WATCH_MAX_POSTS_PER_HOUR=4
WATCH_MAX_POSTS_PER_DAY=30
WATCH_MIN_GAP_SECONDS=180
